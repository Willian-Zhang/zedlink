    "command": "python3",
    "args": ["tools/zedlink_manager.py", "manage-routes"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
    "label": "ZedLink: Check connections",
    "command": "python3",
    "args": ["tools/zedlink_manager.py", "check-routes"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
    "label": "ZedLink: Pair a device",
