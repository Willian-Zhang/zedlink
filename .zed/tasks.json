  {
    "label": "ZedLink: Pair in terminal",
    "command": "python3",
    "args": ["tools/zedlink_manager.py", "pair-terminal"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true,
    "reveal": "always",
    "hide": "never"
