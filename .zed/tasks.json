    "args": ["tools/zedlink_manager.py", "pair"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true,
    "reveal": "never",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "ZedLink: Pair in browser",
    "command": "python3",
    "args": ["tools/zedlink_manager.py", "pair-browser"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
