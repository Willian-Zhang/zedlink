[
  {
    "label": "ZedLink: Set up this project",
    "command": "python3",
    "args": ["tools/zedlink_manager.py", "quick-setup", "$ZED_WORKTREE_ROOT"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
    "label": "ZedLink: Guided setup",
    "command": "bash",
    "args": ["tools/setup_zed_ide.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
    "label": "ZedLink: Install / build",
    "command": "bash",
    "args": ["tools/install_linux.sh"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
    "label": "ZedLink: Configure",
    "command": "python3",
    "args": ["tools/zedlink_manager.py", "configure"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": { "program": "/bin/sh" },
    "use_new_terminal": true
  },
  {
