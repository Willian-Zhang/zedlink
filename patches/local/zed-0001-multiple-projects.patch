+/// Visible folders of the project that are configured roots, with their root path.
+fn exposed_worktrees(
+    project: &project::Project,
+    project_roots: &[PathBuf],
+    cx: &App,
+) -> Vec<(worktree::WorktreeId, PathBuf)> {
+    project
+        .visible_worktrees(cx)
+        .filter_map(|worktree| {
+            let worktree = worktree.read(cx);
+            project_roots
+                .iter()
+                .find(|root| worktree.abs_path().as_ref() == root.as_path())
+                .map(|root| (worktree.id(), root.clone()))
+        })
+        .collect()
+}
