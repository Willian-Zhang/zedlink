+/// New remote sessions open in the first configured root, in settings order,
+/// that is open in a workspace with an Agent panel.
+fn session_creation_target(
+    state: &ProbeState,
+    cx: &App,
+) -> Option<(Entity<AgentPanel>, Entity<project::Project>, PathBuf)> {
+    state.project_roots.iter().find_map(|project_root| {
+        loaded_project_workspaces(std::slice::from_ref(project_root), cx)
+            .into_iter()
+            .find_map(|workspace| {
+                let workspace = workspace.read(cx);
+                let panel = workspace.panel::<AgentPanel>(cx)?;
+                Some((panel, workspace.project().clone(), project_root.clone()))
+            })
+    })
+}
