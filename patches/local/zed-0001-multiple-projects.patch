+
+/// Returns the first configured root, in settings order, that is exactly one
+/// of the project's visible folders. A folder nested inside a root doesn't
+/// count, so opening a parent directory never widens what is exposed.
+fn project_root_for(
+    project: &Entity<project::Project>,
+    project_roots: &[PathBuf],
+    cx: &App,
+) -> Option<PathBuf> {
+    let project = project.read(cx);
+    project_roots
+        .iter()
+        .find(|root| {
+            project
+                .visible_worktrees(cx)
+                .any(|worktree| worktree.read(cx).abs_path().as_ref() == root.as_path())
+        })
+        .cloned()
+}
+
+fn project_names(project_roots: &[PathBuf]) -> String {
+    project_roots
+        .iter()
+        .filter_map(|root| root.file_name().and_then(|name| name.to_str()))
+        .collect::<Vec<_>>()
+        .join(", ")
 }
 
