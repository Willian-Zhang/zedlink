+
+const HISTORY_LOAD_TIMEOUT: Duration = Duration::from_secs(60);
+const MAX_ATTACHABLE_THREADS: usize = 200;
+
+/// Exposed threads, and threads about to be, stay loaded: when Zed unloads an
+/// idle thread from the Agent panel it would silently disappear from paired
+/// devices.
+pub(crate) fn keeps_thread_loaded(thread: &AcpThread, cx: &App) -> bool {
+    let Some(state) = cx.try_global::<ProbeGlobal>() else {
+        return false;
+    };
+    let id = thread.session_id().to_string();
+    state.0.exposed_threads.borrow().contains(&id)
+        || state.0.pending_exposures.borrow().contains_key(&id)
+        || state.0.pending_loads.borrow().contains_key(&id)
+}
+
+/// Saved, unarchived threads of windows with a configured project, in each
+/// window's Agent panel, as the sidebar lists them. Drafts have no session yet
+/// and are left out.
+fn history_threads(
+    project_roots: &[ProjectRoot],
+    cx: &App,
+) -> Vec<(Entity<AgentPanel>, Entity<project::Project>, ThreadMetadata)> {
+    let Some(store) = ThreadMetadataStore::try_global(cx) else {
+        return Vec::new();
+    };
+    let store = store.read(cx);
+    let mut seen = HashSet::new();
+    let mut threads = Vec::new();
+    for workspace in loaded_project_workspaces(project_roots, cx) {
+        let workspace = workspace.read(cx);
+        let Some(panel) = workspace.panel::<AgentPanel>(cx) else {
+            continue;
+        };
+        let project = workspace.project().clone();
+        let path_list = PathList::new(&workspace.root_paths(cx));
+        let remote_connection = project.read(cx).remote_connection_options(cx);
+        let entries = store
+            .entries_for_path(&path_list, remote_connection.as_ref())
+            .chain(store.entries_for_main_worktree_path(&path_list, remote_connection.as_ref()));
+        for metadata in entries {
+            if metadata.session_id.is_some() && seen.insert(metadata.thread_id) {
+                threads.push((panel.clone(), project.clone(), metadata.clone()));
+            }
+        }
+    }
+    threads
+}
+
+fn history_agent_value(
+    agent_id: &project::AgentId,
+    project: &Entity<project::Project>,
+    cx: &App,
+) -> Value {
+    if agent_id.as_ref() == agent::ZED_AGENT_ID.as_ref() {
+        return json!({"id": agent_id.to_string(), "name": "Zed Agent", "kind": "zed"});
+    }
+    let name = project
+        .read(cx)
+        .agent_server_store()
+        .read(cx)
+        .agent_display_name(agent_id)
+        .map(|name| name.to_string())
+        .unwrap_or_else(|| agent_id.to_string());
+    json!({"id": agent_id.to_string(), "name": name, "kind": "external_acp"})
+}
+
+fn load_and_expose(
+    state: &Rc<ProbeState>,
+    panel: &Entity<AgentPanel>,
+    metadata: &ThreadMetadata,
+    cx: &mut App,
+) -> bool {
+    let Some(session_id) = metadata.session_id.as_ref().map(ToString::to_string) else {
+        return false;
+    };
+    let conversation = cx.with_window(panel.entity_id(), |window, cx| {
+        panel.update(cx, |panel, cx| {
+            panel.load_thread_in_background(metadata, window, cx)
+        })
+    });
+    let Some(conversation) = conversation else {
+        return false;
+    };
+    let subscription = cx.observe(&conversation, {
+        let state = state.clone();
+        let session_id = session_id.clone();
+        move |conversation, cx| {
+            if conversation.read(cx).root_thread(cx).is_none() {
+                return;
+            }
+            let state = state.clone();
+            let session_id = session_id.clone();
+            // Finishing drops this subscription, which can't happen inside it.
+            cx.defer(move |cx| finish_history_load(&state, &session_id, &conversation, cx));
+        }
+    });
+    let timeout = cx.spawn({
+        let state = state.clone();
+        let session_id = session_id.clone();
+        async move |cx| {
+            cx.background_executor().timer(HISTORY_LOAD_TIMEOUT).await;
+            cx.update(|_| {
+                if state
+                    .pending_loads
+                    .borrow_mut()
+                    .remove(&session_id)
+                    .is_some()
+                {
+                    log::warn!("ZedLink gave up waiting for a thread to load from history");
+                }
+            });
+        }
+    });
+    state.pending_loads.borrow_mut().insert(
+        session_id.clone(),
+        PendingLoad {
+            _subscription: subscription,
+            _timeout: timeout,
+        },
+    );
+    // A native thread can already be available synchronously.
+    let state = state.clone();
+    cx.defer(move |cx| finish_history_load(&state, &session_id, &conversation, cx));
+    true
+}
+
+fn finish_history_load(
+    state: &Rc<ProbeState>,
+    session_id: &str,
+    conversation: &Entity<ConversationView>,
+    cx: &mut App,
+) {
+    if !state.pending_loads.borrow().contains_key(session_id) {
+        return;
+    }
+    let Some(thread) = conversation.read(cx).root_thread(cx) else {
+        return;
+    };
+    state.pending_loads.borrow_mut().remove(session_id);
+    if thread.read(cx).session_id().to_string() != session_id {
+        log::warn!("ZedLink loaded a different session than requested; not exposing it");
+        return;
+    }
+    if thread_belongs_to_project(&thread, &state.project_roots(), cx) {
+        expose_thread(state, &thread, cx);
+        show_thread_toast(&thread, "A paired device connected to this thread", cx);
+    }
+}
