+pub(crate) enum ExposureChange {
+    Exposed,
+    Stopped,
+    /// The thread's SSH window is still connecting; it is exposed once its
+    /// folders load and match a configured root.
+    WaitingForConnection(String),
+    CancelledWaiting,
+    NotInExposedProject,
+    ProbeUnavailable,
+}
