+fn configured_project_roots(settings: &settings::ZedLinkSettingsContent) -> Vec<String> {
+    settings
+        .project_root
+        .iter()
+        .chain(settings.project_roots.iter().flatten())
+        .map(|path| path.trim())
+        .filter(|path| !path.is_empty())
+        .map(str::to_string)
+        .collect()
+}
+
+fn parse_project_roots(configured_roots: Vec<String>) -> Vec<ProjectRoot> {
+    // Unusable roots are skipped rather than fatal: dropping one only narrows
+    // what is exposed, and one stale entry shouldn't disable the whole bridge.
+    let mut project_roots = Vec::new();
+    for root in configured_roots {
+        let parsed = match ProjectRoot::parse_remote(&root) {
+            Some(Ok(remote)) => remote,
+            Some(Err(reason)) => {
+                log::warn!("ZedLink skipped remote project root {root:?}: {reason}");
+                continue;
+            }
+            None => {
+                let path = PathBuf::from(&root);
+                if !path.is_absolute() {
+                    log::warn!("ZedLink skipped project root that isn't absolute: {root:?}");
+                    continue;
+                }
+                match fs::canonicalize(&path) {
+                    Ok(canonical) if canonical.is_dir() => ProjectRoot {
+                        ssh_host: None,
+                        path: canonical,
+                    },
+                    _ => {
+                        log::warn!("ZedLink skipped unavailable project root: {root:?}");
+                        continue;
+                    }
+                }
+            }
+        };
+        if !project_roots.contains(&parsed) {
+            project_roots.push(parsed);
+        }
+    }
+    project_roots
+}
+
+/// Applies `project_root`/`project_roots` edits without a restart. Turning
+/// `enabled` off empties the list. Threads whose project is no longer
+/// configured stop being exposed, so removing a root revokes access at once
+/// instead of hiding threads that would reappear if the root came back.
+fn reload_project_roots(state: &Rc<ProbeState>, cx: &mut App) {
+    let configured = cx
+        .global::<SettingsStore>()
+        .merged_settings()
+        .zedlink
+        .as_ref()
+        .filter(|settings| settings.enabled.unwrap_or(false))
+        .map(configured_project_roots)
+        .unwrap_or_default();
+    if *state.configured_roots.borrow() == configured {
+        return;
+    }
+    let project_roots = parse_project_roots(configured.clone());
+    *state.configured_roots.borrow_mut() = configured;
+    if *state.project_roots.borrow() == project_roots {
+        return;
+    }
+    log::info!(
+        "ZedLink project roots changed: {} available",
+        project_roots.len()
+    );
+    *state.project_roots.borrow_mut() = project_roots;
+
+    let project_roots = state.project_roots();
+    let eligible = loaded_threads(&project_roots, cx)
+        .into_iter()
+        .map(|thread| thread.read(cx).session_id().to_string())
+        .collect::<HashSet<_>>();
+    let revoked = state
+        .exposed_threads
+        .borrow()
+        .iter()
+        .filter(|id| !eligible.contains(*id))
+        .cloned()
+        .collect::<Vec<_>>();
+    for id in revoked {
+        stop_exposure(state, &id);
+    }
+    let pending = state
+        .pending_exposures
+        .borrow()
+        .keys()
+        .cloned()
+        .collect::<Vec<_>>();
+    for id in pending {
+        finish_pending_exposure(state, &id, cx);
     }
+}
+
+fn stop_exposure(state: &ProbeState, thread_id: &str) -> bool {
+    let was_exposed = state.exposed_threads.borrow_mut().remove(thread_id);
+    state.subscriptions.borrow_mut().remove(thread_id);
+    state.events.borrow_mut().remove(thread_id);
+    was_exposed
+}
