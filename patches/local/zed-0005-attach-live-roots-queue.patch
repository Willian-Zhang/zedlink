+/// Open threads in exposed projects that a paired device may connect to
+/// because the desktop enabled `allow_remote_attach`, plus threads in SSH
+/// windows that are still connecting to a configured host.
+fn attachable_threads(request: &ProbeRequest, state: &ProbeState, cx: &mut App) -> Value {
+    if !matches_instance(request, state) {
+        return error(&request.request_id, "INSTANCE_UNAVAILABLE");
+    }
+    let project_roots = state.project_roots();
+    let exposed = state.exposed_threads.borrow().clone();
+    let pending = state
+        .pending_exposures
+        .borrow()
+        .keys()
+        .cloned()
+        .collect::<HashSet<_>>();
+    let mut seen = HashSet::new();
+    let threads = all_root_thread_views(cx)
+        .into_iter()
+        .filter_map(|(thread, view)| {
+            let id = thread.read(cx).session_id().to_string();
+            if exposed.contains(&id) || !seen.insert(id.clone()) {
+                return None;
+            }
+            let waiting_host = if thread_belongs_to_project(&thread, &project_roots, cx) {
+                None
+            } else {
+                Some(ssh_waiting_host(&thread, &project_roots, cx)?)
+            };
+            let thread = thread.read(cx);
+            Some(json!({
+                "thread_id": id,
+                "agent": thread_agent_value(&view, cx),
+                "title": thread.title().map(|title| title.to_string()),
+                "status": format!("{:?}", thread.status()),
+                "activity": thread_activity_value(thread),
+                "project_group": if waiting_host.is_none() {
+                    project_group_value(thread.project(), &project_roots, cx)
+                } else {
+                    Value::Null
+                },
+                "waiting": waiting_host
+                    .map(|host| json!({"kind": "ssh_connection", "host": host})),
+                "pending": pending.contains(&id),
+            }))
+        })
+        .collect::<Vec<_>>();
+    success(
+        &request.request_id,
+        json!({
+            "instance_id": state.instance_id,
+            "epoch": state.epoch,
+            "threads": threads,
+        }),
+    )
+}
+
+fn attach_thread(request: &ProbeRequest, state: &ProbeState, cx: &mut App) -> Value {
+    if !matches_instance(request, state) {
+        return error(&request.request_id, "INSTANCE_UNAVAILABLE");
+    }
+    let Some(thread_id) = request
+        .params
+        .get("thread_id")
+        .and_then(Value::as_str)
+        .filter(|id| !id.is_empty() && id.len() <= 128)
+    else {
+        return error(&request.request_id, "INVALID_REQUEST");
+    };
+    let outcome = |outcome: &str| {
+        success(
+            &request.request_id,
+            json!({"thread_id": thread_id, "outcome": outcome}),
+        )
+    };
+    if state.exposed_threads.borrow().contains(thread_id) {
+        return outcome("already_attached");
+    }
+    if state.pending_exposures.borrow().contains_key(thread_id) {
+        return outcome("pending");
+    }
+    let Some((thread, view)) = all_root_thread_views(cx)
+        .into_iter()
+        .find(|(thread, _)| thread.read(cx).session_id().to_string() == thread_id)
+    else {
+        return error(&request.request_id, "THREAD_UNAVAILABLE");
+    };
+    let probe_state = cx.global::<ProbeGlobal>().0.clone();
+    let project_roots = state.project_roots();
+    if thread_belongs_to_project(&thread, &project_roots, cx) {
+        expose_thread(&probe_state, &thread, cx);
+        view.update(cx, |view, cx| {
+            view.show_local_command_toast("A paired device connected to this thread", cx)
+        });
+        outcome("attached")
+    } else if ssh_waiting_host(&thread, &project_roots, cx).is_some() {
+        expose_when_ready(&probe_state, &thread, cx);
+        view.update(cx, |view, cx| {
+            view.show_local_command_toast(
+                "A paired device will connect to this thread once SSH is ready",
+                cx,
+            )
+        });
+        outcome("pending")
+    } else {
+        error(&request.request_id, "THREAD_UNAVAILABLE")
+    }
+}
