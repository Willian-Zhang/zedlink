+/// Per-message queue controls, using the same queue operations as the
+/// desktop's Send Now, Steer, edit and remove buttons.
+fn update_queued_message(request: &ProbeRequest, state: &ProbeState, cx: &mut App) -> Value {
+    if !matches_instance(request, state) {
+        return error(&request.request_id, "INSTANCE_UNAVAILABLE");
+    }
+    let Some(thread_id) = request.params.get("thread_id").and_then(Value::as_str) else {
+        return error(&request.request_id, "INVALID_REQUEST");
+    };
+    let Some(queue_entry_id) = request
+        .params
+        .get("queue_entry_id")
+        .and_then(Value::as_u64)
+        .and_then(|value| usize::try_from(value).ok())
+    else {
+        return error(&request.request_id, "INVALID_REQUEST");
+    };
+    let Some(action) = request.params.get("action").and_then(Value::as_str) else {
+        return error(&request.request_id, "INVALID_REQUEST");
+    };
+    let Some((_, view)) = exposed_thread_view(thread_id, state, cx) else {
+        return error(&request.request_id, "THREAD_NOT_EXPOSED");
+    };
+    let entry = view
+        .read(cx)
+        .message_queue
+        .iter()
+        .find(|entry| entry.id.as_usize() == queue_entry_id)
+        .map(|entry| (entry.id, entry.remote_request_id.clone()));
+    let Some((entry_id, remote_request_id)) = entry else {
+        return match action {
+            "send_now" | "steer" | "remove" | "edit" => {
+                success(&request.request_id, json!({"outcome": "not_queued"}))
+            }
+            _ => error(&request.request_id, "INVALID_REQUEST"),
+        };
+    };
+    let outcome = match action {
+        "remove" => {
+            let removed = view.update(cx, |view, cx| {
+                let removed = view.remove_from_queue(entry_id, cx).is_some();
+                cx.notify();
+                removed
+            });
+            if !removed {
+                "not_queued"
+            } else {
+                if let Some(remote_request_id) = remote_request_id
+                    && let Some(record) = state.submissions.borrow_mut().get_mut(&remote_request_id)
+                {
+                    record.outcome = "removed";
+                }
+                "removed"
+            }
+        }
+        "steer" => {
+            let Some(steer) = request.params.get("steer").and_then(Value::as_bool) else {
+                return error(&request.request_id, "INVALID_REQUEST");
+            };
+            view.update(cx, |view, cx| view.set_queue_entry_steer(entry_id, steer, cx));
+            "updated"
+        }
+        "edit" => {
+            let Some(text) = request
+                .params
+                .get("text")
+                .and_then(Value::as_str)
+                .filter(|text| !text.trim().is_empty() && text.len() <= 3000 && !text.contains('\0'))
+            else {
+                return error(&request.request_id, "INVALID_REQUEST");
+            };
+            let edited = cx.with_window(view.entity_id(), |window, cx| {
+                view.update(cx, |view, cx| {
+                    view.replace_queued_message_text(entry_id, text.to_string(), window, cx)
+                })
+            });
+            match edited {
+                Some(true) => "updated",
+                Some(false) => "rejected",
+                None => return error(&request.request_id, "INSTANCE_UNAVAILABLE"),
+            }
+        }
+        "send_now" => {
+            let sent = cx.with_window(view.entity_id(), |window, cx| {
+                view.update(cx, |view, cx| {
+                    view.send_queued_message_now(entry_id, window, cx);
+                    view.message_queue.entry_by_id(entry_id).is_none()
+                })
+            });
+            match sent {
+                Some(true) => "sent",
+                Some(false) => "rejected",
+                None => return error(&request.request_id, "INSTANCE_UNAVAILABLE"),
+            }
+        }
+        _ => return error(&request.request_id, "INVALID_REQUEST"),
+    };
+    success(
+        &request.request_id,
+        json!({"thread_id": thread_id, "queue_entry_id": queue_entry_id, "outcome": outcome}),
+    )
+}
