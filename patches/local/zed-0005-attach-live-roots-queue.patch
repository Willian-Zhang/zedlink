+struct PendingExposure {
+    thread: WeakEntity<AcpThread>,
+    _subscriptions: Vec<Subscription>,
+}
+
+fn expose_when_ready(state: &Rc<ProbeState>, thread: &Entity<AcpThread>, cx: &mut App) {
+    let id = thread.read(cx).session_id().to_string();
+    if state.pending_exposures.borrow().contains_key(&id) {
+        return;
+    }
+    let project = thread.read(cx).project().clone();
+    // Checks run deferred because finishing drops these subscriptions, which
+    // must not happen inside their own callbacks.
+    let schedule_check = {
+        let state = state.clone();
+        let id = id.clone();
+        move |cx: &mut App| {
+            let state = state.clone();
+            let id = id.clone();
+            cx.defer(move |cx| finish_pending_exposure(&state, &id, cx));
+        }
+    };
+    let mut subscriptions = vec![cx.subscribe(&project, {
+        let schedule_check = schedule_check.clone();
+        move |_, event: &project::Event, cx| {
+            if matches!(
+                event,
+                project::Event::WorktreeAdded(_) | project::Event::WorktreeRemoved(_)
+            ) {
+                schedule_check(cx);
+            }
+        }
+    })];
+    if let Some(remote_client) = project.read(cx).remote_client() {
+        subscriptions.push(cx.observe(&remote_client, {
+            let schedule_check = schedule_check.clone();
+            move |_, cx| schedule_check(cx)
+        }));
+    }
+    subscriptions.push(cx.observe_release(thread, {
+        let state = state.clone();
+        let id = id.clone();
+        move |_, cx| {
+            cx.defer(move |_| {
+                state.pending_exposures.borrow_mut().remove(&id);
+            });
+        }
+    }));
+    state.pending_exposures.borrow_mut().insert(
+        id,
+        PendingExposure {
+            thread: thread.downgrade(),
+            _subscriptions: subscriptions,
+        },
+    );
+}
+
+fn finish_pending_exposure(state: &Rc<ProbeState>, thread_id: &str, cx: &mut App) {
+    let thread = state
+        .pending_exposures
+        .borrow()
+        .get(thread_id)
+        .map(|pending| pending.thread.clone());
+    let Some(thread) = thread else {
+        return;
+    };
+    let Some(thread) = thread.upgrade() else {
+        state.pending_exposures.borrow_mut().remove(thread_id);
+        return;
+    };
+    let project_roots = state.project_roots();
+    if thread_belongs_to_project(&thread, &project_roots, cx) {
+        state.pending_exposures.borrow_mut().remove(thread_id);
+        expose_thread(state, &thread, cx);
+        show_thread_toast(&thread, "Thread exposed to ZedLink", cx);
+    } else if ssh_waiting_host(&thread, &project_roots, cx).is_none() {
+        state.pending_exposures.borrow_mut().remove(thread_id);
+        show_thread_toast(
+            &thread,
+            "ZedLink didn't expose this thread: its SSH folder isn't a configured project",
+            cx,
+        );
     }
 }
 
