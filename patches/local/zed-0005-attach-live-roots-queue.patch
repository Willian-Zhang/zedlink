+/// The full text of a queued message that holds nothing but text, which is the
+/// only kind a paired device can edit without dropping mentions or images.
+fn queued_plain_text(content: &[acp::ContentBlock]) -> Option<String> {
+    let mut texts = Vec::new();
+    for block in content {
+        match block {
+            acp::ContentBlock::Text(text) => texts.push(text.text.as_str()),
+            _ => return None,
+        }
+    }
+    (!texts.is_empty()).then(|| texts.join("\n"))
+}
