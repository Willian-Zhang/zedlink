+/// A configured exposed folder: local, or on an SSH host (`ssh://host/path`).
+#[derive(Clone, PartialEq)]
+struct ProjectRoot {
+    ssh_host: Option<String>,
+    path: PathBuf,
+}
+
+impl ProjectRoot {
+    fn parse_remote(value: &str) -> Option<std::result::Result<Self, &'static str>> {
+        let remote = value.strip_prefix("ssh://")?;
+        let Some(separator) = remote.find('/') else {
+            return Some(Err("needs ssh://host/absolute/path"));
+        };
+        let (host, path) = remote.split_at(separator);
+        if host.is_empty() || host.contains(['@', ':']) {
+            return Some(Err("host must be a plain SSH host name"));
+        }
+        let path = Path::new(path);
+        if path
+            .components()
+            .any(|component| !matches!(component, Component::RootDir | Component::Normal(_)))
+        {
+            return Some(Err("remote path must be absolute without '.' or '..'"));
+        }
+        Some(Ok(Self {
+            ssh_host: Some(host.to_string()),
+            path: path.components().collect(),
+        }))
+    }
+
+    /// A folder counts only when it is exactly the root path on the same
+    /// machine: a local root never matches a remote project with the same
+    /// path, and a remote root only matches a project on that SSH host.
+    fn matches(&self, project: &project::Project, worktree: &worktree::Worktree, cx: &App) -> bool {
+        if worktree.abs_path().as_ref() != self.path.as_path() {
+            return false;
+        }
+        match &self.ssh_host {
+            None => project.is_local(),
+            Some(host) => match project.remote_connection_options(cx) {
+                Some(remote::RemoteConnectionOptions::Ssh(options)) => {
+                    options.host.to_string() == *host
+                        || options.nickname.as_deref() == Some(host.as_str())
+                }
+                _ => false,
+            },
+        }
+    }
+
+    /// Remote roots have no local files, so local file, search and Git
+    /// access is refused for them instead of touching the Mac's disk.
+    fn local_path(&self) -> std::result::Result<PathBuf, &'static str> {
+        match self.ssh_host {
+            None => Ok(self.path.clone()),
+            Some(_) => Err("UNSUPPORTED_CAPABILITY"),
+        }
+    }
+
+    fn display_name(&self) -> Option<String> {
+        let name = self.path.file_name()?.to_str()?;
+        Some(match &self.ssh_host {
+            None => name.to_string(),
+            Some(host) => format!("{name} ({host})"),
+        })
+    }
+}
