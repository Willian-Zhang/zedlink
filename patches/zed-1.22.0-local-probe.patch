+fn zedlink_page() -> SettingsPage {
+    fn connections_section() -> [SettingsPageItem; 2] {
+        [
+            SettingsPageItem::SectionHeader("Connections"),
+            SettingsPageItem::SubPageLink(SubPageLink {
+                title: "Connection Providers".into(),
